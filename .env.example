# ========================================================
# SISTEMA DE GESTIÓN DE FLOTA VEHICULAR
# Plantilla de Variables de Entorno (.env.example)
# ========================================================

# Configuración General
APP_NAME="Sistema de Gestión de Flota Vehicular"
APP_ENV=local
APP_DEBUG=true
BASE_URL=/flota

# ========================================================
# OPCIÓN A: Configuración para DESPLIEGUE EN DOCKER
# ========================================================
# Puertos externos del Host para Docker
APP_PORT=8080
PMA_PORT=8081
DB_EXTERNAL_PORT=3307

# Credenciales de Base de Datos para Docker
DB_HOST=db
DB_PORT=3306
DB_NAME=flota_vehicular
DB_USER=flota_user
DB_PASS=flota_secret_2026
DB_ROOT_PASS=root_secret_2026
DB_CHARSET=utf8mb4

# ========================================================
# OPCIÓN B: Configuración para XAMPP / Servidor Local Nativo
# (Descomentar si ejecutas con Apache y MySQL de XAMPP)
# ========================================================
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=flota_vehicular
# DB_USER=root
# DB_PASS=
# DB_CHARSET=utf8mb4
